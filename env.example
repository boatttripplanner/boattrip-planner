# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google Gemini AI API
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AccuWeather API
VITE_ACCUWEATHER_API_KEY=your_accuweather_api_key_here

# Amazon Associates API (for product recommendations)
VITE_AMAZON_ACCESS_KEY_ID=your_amazon_access_key_id
VITE_AMAZON_SECRET_ACCESS_KEY=your_amazon_secret_access_key
VITE_AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag

# Unsplash API (for blog images)
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Application Settings
VITE_APP_ENV=development
VITE_BASE_URL=http://localhost:5174
