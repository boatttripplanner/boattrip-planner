# Variables de Entorno para Desarrollo Local
# Este archivo NO se debe commitear al repositorio

# Entorno
NODE_ENV=development
VITE_APP_ENV=development

# URLs de desarrollo
VITE_BASE_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:5174

# Google Gemini AI API (para desarrollo)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# AccuWeather API (para desarrollo)
VITE_ACCUWEATHER_API_KEY=your_accuweather_api_key_here

# Amazon Associates API (para desarrollo)
VITE_AMAZON_ACCESS_KEY_ID=your_amazon_access_key_id
VITE_AMAZON_SECRET_ACCESS_KEY=your_amazon_secret_access_key
VITE_AMAZON_ASSOCIATE_TAG=explorashop18-21

# Unsplash API (para desarrollo)
VITE_UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Configuración de desarrollo
VITE_ENABLE_LOGGING=true
VITE_ENABLE_DEBUG=true
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_PWA=true

# Configuración de desarrollo específica
VITE_DEV_MODE=true
VITE_HOT_RELOAD=true
VITE_SOURCE_MAPS=true
