{
  "name": "BoatTrip Planner - Planificador de Viajes en Barco",
  "short_name": "BoatTrip",
  "description": "Planifica tu viaje en barco perfecto con IA avanzada. Funciona offline y sincroniza automáticamente.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0d9488",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "es",
  "dir": "ltr",
  "categories": ["travel", "navigation", "lifestyle", "utilities"],
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nuevo Viaje",
      "short_name": "Viaje",
      "description": "Crear un nuevo plan de viaje",
      "url": "/wizard",
      "icons": [
        {
          "src": "/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Mis Viajes",
      "short_name": "Viajes",
      "description": "Ver historial de viajes",
      "url": "/history",
      "icons": [
        {
          "src": "/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Estado Offline",
      "short_name": "Offline",
      "description": "Gestionar modo offline y sincronización",
      "url": "/offline",
      "icons": [
        {
          "src": "/web-app-manifest-192x192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Pantalla principal de BoatTrip Planner"
    },
    {
      "src": "/screenshots/mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Vista móvil del planificador"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+boattrip",
      "url": "/?route=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/upload",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "handle_links": "preferred",
  "capture_links": "existing-client-navigate",
  "permissions": [
    "notifications",
    "background-sync",
    "periodic-background-sync"
  ],
  "background": {
    "service_worker": "/sw.js",
    "type": "module"
  },
  "features": [
    "Cross Platform",
    "Offline Support",
    "Push Notifications",
    "Background Sync",
    "Installable",
    "Responsive Design"
  ],
  "developer": {
    "name": "BoatTrip Team",
    "url": "https://boattrip-planner.com"
  },
  "version": "2.0.0",
  "minimum_version": "1.0.0"
}