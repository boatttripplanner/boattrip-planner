{
  "name": "boattrip-planner",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.dev.ts",
    "build": "vite build",
    "prebuild": "npm run update-comparisons",
    "build:analyze": "vite build --config vite.config.analyze.ts",
    "preview": "vite preview",
    "deploy": "vercel --prod",
    "lighthouse": "lighthouse https://boattrip-planner.com --output=html --output-path=./lighthouse-report.html",
    "performance": "npm run build && npm run lighthouse",
    "generate-favicons": "node scripts/generate-favicons.js",
    "create-favicon-ico": "node scripts/create-favicon-ico.js",
    "clean": "node scripts/clean-code.js",
    "lint": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm run format",
    "check-dev": "node scripts/check-dev-server.js",
    "verify": "node scripts/verify-dev-setup.js",
    "update-comparisons": "node scripts/update-blog-comparisons-from-amazon.js"
  },
  "dependencies": {
    "@google/genai": "^1.3.0",
    "@google/generative-ai": "^0.24.1",
    "@vercel/kv": "^1.0.0",
    "@vercel/node": "^3.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "hast": "^1.0.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.536.0",
    "node-fetch": "^3.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.0",
    "react-router-dom": "^7.7.1",
    "remark-gfm": "^4.0.0",
    "resend": "^3.0.0",
    "sharp": "^0.34.3",
    "unsplash-js": "^7.0.19"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.6",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.5.6",
    "prettier": "^3.2.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "tailwindcss": "^3.4.17",
    "terser": "^5.29.2",
    "typescript": "~5.7.2",
    "vercel": "^44.5.3",
    "vite": "^6.2.0"
  }
}
